# Docker Compose: the whole stack (database, migrations, API, web).
#
# `docker compose up` also merges compose.override.yaml (development settings).
# For a production-like run without it: docker compose -f compose.yaml up
name: {{ project_slug }}

# Environment shared by every service that runs the API code (migrate, api)
x-api-environment: &api-environment
  APP_NAME: ${APP_NAME:-API}
  POSTGRES_USER: ${POSTGRES_USER:?set POSTGRES_USER in .env}
  POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env (run make setup)}
  POSTGRES_DB: ${POSTGRES_DB:?set POSTGRES_DB in .env}
  # "db" is the service name below: Compose's internal DNS resolves it to the db container
  POSTGRES_HOST: db
  # Port inside the Compose network (POSTGRES_PORT in .env is the port on your machine)
  POSTGRES_PORT: 5432
  JWT_SECRET_KEY: ${JWT_SECRET_KEY:?set JWT_SECRET_KEY in .env (run make setup)}
  ACCESS_TOKEN_EXPIRE_MINUTES: ${ACCESS_TOKEN_EXPIRE_MINUTES:-60}
  CORS_ORIGINS: '["http://localhost:${WEB_PORT:-3000}"]'

services:
  db:
    image: {% if use_pgvector %}pgvector/pgvector:pg18{% else %}postgres:18-alpine{% endif %}
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      # Published on 127.0.0.1 only: reachable from your machine, not from your network
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: unless-stopped

  # One-off job: applies the Alembic migrations, then exits
  migrate:
    build: ./apps/api
    command: ["alembic", "upgrade", "head"]
    environment: *api-environment
    depends_on:
      db:
        condition: service_healthy
    restart: "no"

  api:
    build: ./apps/api
    environment: *api-environment
    ports:
      - "127.0.0.1:${API_PORT:-8000}:8000"
    depends_on:
      db:
        condition: service_healthy
      # Start the API only once the database schema is up to date
      migrate:
        condition: service_completed_successfully
    healthcheck:
      # The slim image has no curl, so use Python's standard library
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 20s
    restart: unless-stopped

  web:
    build:
      context: ./apps/web
      target: runtime
    environment:
      # The web server calls the API over the Compose network, never from the browser
      API_URL: http://api:8000
    ports:
      - "127.0.0.1:${WEB_PORT:-3000}:3000"
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    restart: unless-stopped

volumes:
  pgdata:
